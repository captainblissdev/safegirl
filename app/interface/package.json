{
  "name": "safegirl-frontend",
  "version": "0.1.0",
  "description": "SafeGirl PWA frontend — mobile-first, responsive, anonymous, and privacy-conscious.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/offline/offlinePipeline.test.ts",
